# ====== USER CONFIG ======
USER_ID="user1"

OTP_URL="https://raw.githubusercontent.com/USERNAME/REPO/main/${USER_ID}.txt"

ui_print "Checking access for $USER_ID..."

REMOTE_OTP=$(curl -m 5 -s "$OTP_URL" 2>/dev/null)

if [ -z "$REMOTE_OTP" ]; then
    ui_print "❌ Error fetching data"
    exit 1
fi

if [ "$REMOTE_OTP" = "OFF" ]; then
    ui_print "❌ Access Revoked!"
    exit 1
fi

ui_print "✅ Access Granted"

#!/system/bin/sh

USER_ID="user1"
OTP_URL="https://raw.githubusercontent.com/USERNAME/REPO/main/${USER_ID}.txt"

while true; do
    REMOTE_OTP=$(curl -m 5 -s "$OTP_URL" 2>/dev/null)

    if [ "$REMOTE_OTP" = "OFF" ]; then
        rm -rf /data/adb/modules/اسم_الموديول
    fi

    sleep 60
done



# ===== OTP CONTROL START =====

USER_ID="user1"
OTP_URL="https://raw.githubusercontent.com/USERNAME/REPO/main/${USER_ID}.txt"

sleep 20

(
while true; do
    REMOTE_OTP=$(curl -m 5 -s "$OTP_URL" 2>/dev/null)

    if [ "$REMOTE_OTP" = "OFF" ]; then
        touch "$MODPATH/disable"
    else
        rm -f "$MODPATH/disable"
    fi

    sleep 60
done
) &

# ===== OTP CONTROL END =====
